}

#cancelBtn{
	background-color:#ffffff;
	border:1px solid #dcdfe6;
	border-radius:5px;
	color:#888a8d;
}

#cancelBtn:hover{
	background-color:#e8f4ff;
	border-color:#badeff;
	color:#42a5ff;
}

#cancelBtn:pressed{
	border-color:#1682e6;
}

#okBtn{
	background-color:#1890ff;
	border-radius:5px;
	color:white;
}

#okBtn:pressed{
	background-color:#1682e6
}</string>
